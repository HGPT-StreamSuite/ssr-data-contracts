{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SSR Query Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query_id", "run_id", "message_id", "question_id", "query_type", "status", "materials", "sources"],
  "properties": {
    "schema_version": { "const": "ssr.query-result.v1" },
    "query_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "message_id": { "type": "string", "minLength": 1 },
    "question_id": { "type": "string", "minLength": 1 },
    "query_type": { "enum": ["weather", "person", "game_info", "game_guide", "game_item"] },
    "status": { "enum": ["ok", "no_match", "unavailable", "error"] },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_id", "title", "content", "source_ids"],
        "properties": {
          "material_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "knowledge_version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "locator"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "source_type": { "enum": ["wiki", "web", "api", "other"] },
          "locator": { "type": "string", "minLength": 1 },
          "observed_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
